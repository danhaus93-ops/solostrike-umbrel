server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # --- Compression ---------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/javascript text/xml text/csv
        application/javascript application/json application/xml
        application/xml+rss image/svg+xml;

    # --- Security headers ----------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header Referrer-Policy        "no-referrer" always;

    # --- REST API proxy ------------------------------------------------------
    # v3.2.0: API_HOST is injected per-store by docker-compose and substituted
    # at container start by nginx's envsubst template mechanism. Umbrel's
    # umbrel_main_network is shared across all apps, so the bare 'api' alias
    # collides with other apps (e.g. mempool_api_1) and Docker DNS round-robins
    # between them, causing intermittent 502s. The FULL container name is unique
    # — but it differs per store (danhaus93-solostrike_api_1 vs lonestrike_api_1),
    # so it cannot be baked into the image.
    location /api/ {
        proxy_pass         http://${API_HOST}:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host               $host;
        proxy_set_header   X-Real-IP          $remote_addr;
        proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto  $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # --- WebSocket proxy (long-lived, needs generous timeouts) --------------
    # UI connects to /api/ws (see WS_URL in App.jsx)
    # v3.2.0: see comment on REST API location above re: API_HOST.
    location /api/ws {
        proxy_pass         http://${API_HOST}:3001/api/ws;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade            $http_upgrade;
        proxy_set_header   Connection         "Upgrade";
        proxy_set_header   Host               $host;
        proxy_set_header   X-Real-IP          $remote_addr;
        proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- Prometheus metrics -------------------------------------------------
    # v3.2.0: /metrics is the ONLY path allowed to bypass Umbrel's app_proxy
    # auth (see PROXY_AUTH_WHITELIST in docker-compose.yml). Previously it was
    # whitelisted but had no location block, so it fell through to the SPA
    # fallback and returned index.html instead of Prometheus output.
    location = /metrics {
        proxy_pass         http://${API_HOST}:3001/metrics;
        proxy_http_version 1.1;
        proxy_set_header   Host               $host;
        proxy_set_header   X-Real-IP          $remote_addr;
        proxy_read_timeout 30s;
    }

    # --- Static assets: aggressive cache, hashed filenames are immutable ----
    location ~* \.(?:js|mjs|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # --- SPA fallback: everything else -> index.html ----------------------
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
